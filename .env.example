# ---------------------------------------------------------------------------
# YouTube Download Bot — пример конфигурации.
# Скопируйте файл в .env (рядом с package.json) и заполните значения.
# .env не попадает в git: см. .gitignore.
# ---------------------------------------------------------------------------

# Обязательно. Токен бота от @BotFather.
BOT_TOKEN=123456789:AAaaBBbbCCccDDddEEeeFFffGGggHHhhIIii

# Обязательно. Telegram ID тех, кому разрешено пользоваться ботом
# (несколько значений через запятую или пробел). ID можно узнать у @userinfobot.
ALLOWED_TELEGRAM_IDS=11111111,22222222

# Адрес Bot API. Оставьте пустым для облачного api.telegram.org (лимит отправки 50 МБ).
# Для self-hosted Bot API сервера укажите его адрес, например http://127.0.0.1:8081
# (тогда можно поднять лимит до 2000 МБ, см. TELEGRAM_UPLOAD_LIMIT_MB).
# TELEGRAM_API_ROOT=

# Максимальный размер отправляемого файла в мегабайтах.
# 50 — облачный Bot API, до 2000 — локальный Bot API или MTProto.
# По умолчанию: 2000, если задан MTPROTO (api_id/api_hash), иначе 50.
# TELEGRAM_UPLOAD_LIMIT_MB=50

# ---------------------------------------------------------------------------
# MTProto: отправка файлов до 2000 МиБ (4000 частей по 512 КиБ).
# api_id и api_hash берутся на https://my.telegram.org/apps.
# Задавать нужно оба; тогда бот входит по BOT_TOKEN через auth.importBotAuthorization
# и отправляет крупные файлы мимо 50-мегабайтного лимита Bot API.
# ---------------------------------------------------------------------------
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Начиная с какого размера (МБ) файл уходит через MTProto, а не через Bot API.
# По умолчанию — лимит настроенного Bot API (50 для облачного).
# Чтобы проверить MTProto на маленьком файле, поставьте 1.
# MTPROTO_THRESHOLD_MB=50

# Файл сессии MTProto (ключ авторизации). По умолчанию — рядом с WORK_DIR.
# MTPROTO_SESSION_FILE=/var/lib/youtube-download-bot/mtproto-session.txt

# Таймаут отправки через MTProto (мс). Файл в 2 ГБ по медленной сети идёт долго.
# MTPROTO_UPLOAD_TIMEOUT_MS=7200000

# Сколько загрузок выполнять одновременно и сколько задач держать в очереди.
# MAX_CONCURRENT_DOWNLOADS=2
# MAX_QUEUE_SIZE=20

# Таймауты (мс): получение метаданных, скачивание, отправка в Telegram.
# METADATA_TIMEOUT_MS=60000
# DOWNLOAD_TIMEOUT_MS=1800000
# UPLOAD_TIMEOUT_MS=600000

# Как часто обновлять сообщение с прогрессом (мс, не чаще одного раза в секунду).
# PROGRESS_UPDATE_INTERVAL_MS=2000

# Каталог для временных файлов. Должен быть на диске с запасом места.
# WORK_DIR=data/work

# Пути к внешним бинарникам. Если yt-dlp/ffmpeg лежат не в PATH, укажите
# абсолютные пути. FFMPEG_LOCATION подставляется в yt-dlp как --ffmpeg-location.
# YTDLP_BIN=yt-dlp
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# FFMPEG_LOCATION=/usr/bin

# ---------------------------------------------------------------------------
# Защита от блокировок YouTube (всё бесплатно, прокси не нужен).
# ---------------------------------------------------------------------------

# Файл cookies в формате Netscape (экспорт из браузера с залогиненным Google).
# Снимает проверки «подтвердите, что вы не робот» на IP дата-центра.
# YTDLP_COOKIES_FILE=/etc/youtube-download-bot/cookies.txt

# Пауза между сетевыми запросами yt-dlp, секунды (0 — выключить).
# YTDLP_SLEEP_REQUESTS=1

# Маскировка под браузер: chrome, safari, firefox... Список: yt-dlp --list-impersonate-targets
# YTDLP_IMPERSONATE=chrome

# Ограничение скорости загрузки, например 5M. Не про блокировки, а про канал и диск.
# YTDLP_LIMIT_RATE=5M

# Уровень логов: debug, info, warn, error.
# LOG_LEVEL=info
