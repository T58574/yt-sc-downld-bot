# ---------------------------------------------------------------------------
# YouTube Download Bot — пример конфигурации.
# Скопируйте файл в .env (рядом с package.json) и заполните значения.
# .env не попадает в git: см. .gitignore.
# ---------------------------------------------------------------------------

# Обязательно. Токен бота от @BotFather.
BOT_TOKEN=123456789:AAaaBBbbCCccDDddEEeeFFffGGggHHhhIIii

# Обязательно. Telegram ID тех, кому разрешено пользоваться ботом
# (несколько значений через запятую или пробел). ID можно узнать у @userinfobot.
ALLOWED_TELEGRAM_IDS=11111111,22222222

# Адрес Bot API. Оставьте пустым для облачного api.telegram.org (лимит отправки 50 МБ).
# Для self-hosted Bot API сервера укажите его адрес, например http://127.0.0.1:8081
# (тогда можно поднять лимит до 2000 МБ, см. TELEGRAM_UPLOAD_LIMIT_MB).
# TELEGRAM_API_ROOT=

# Максимальный размер отправляемого файла в мегабайтах.
# 50 — облачный Bot API, до 2000 — локальный Bot API.
# TELEGRAM_UPLOAD_LIMIT_MB=50

# Сколько загрузок выполнять одновременно и сколько задач держать в очереди.
# MAX_CONCURRENT_DOWNLOADS=2
# MAX_QUEUE_SIZE=20

# Таймауты (мс): получение метаданных, скачивание, отправка в Telegram.
# METADATA_TIMEOUT_MS=60000
# DOWNLOAD_TIMEOUT_MS=1800000
# UPLOAD_TIMEOUT_MS=600000

# Как часто обновлять сообщение с прогрессом (мс, не чаще одного раза в секунду).
# PROGRESS_UPDATE_INTERVAL_MS=2000

# Каталог для временных файлов. Должен быть на диске с запасом места.
# WORK_DIR=data/work

# Пути к внешним бинарникам. Если yt-dlp/ffmpeg лежат не в PATH, укажите
# абсолютные пути. FFMPEG_LOCATION подставляется в yt-dlp как --ffmpeg-location.
# YTDLP_BIN=yt-dlp
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# FFMPEG_LOCATION=/usr/bin

# Уровень логов: debug, info, warn, error.
# LOG_LEVEL=info
